---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCard from "../components/BookCard.astro";
import { createAuthorJsonLd, siteConfig } from "../lib/seo";
import { getCollection } from "astro:content";

const books = await getCollection("books");
---

<BaseLayout
  title="Charlotte Thornet — Autrice de fantasy"
  description={siteConfig.defaultDescription}
  canonical="/"
  jsonLd={createAuthorJsonLd()}
>
  <section class="hero">
    <p class="eyebrow">Fantasy · Dragons · Magie · Ironie</p>
    <h1>Charlotte Thornet</h1>
    <p>
      Écrire pour que cohabitent dragons, magie, forces cosmiques et dérision.
    </p>
    <p>
      Inventer un monde merveilleux pour raconter nos différences, nos contradictions et nos tendresses. 
    </p>
    <p>
      Lancer des sorts pour qu'ils révèlent ce qui nous rend singuliers.
    </p>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <h2>Romans</h2>
      <a href="/romans">Tous les romans →</a>
    </div>

    <div class="home-books-grid">
      {
        books.map((book) => (
          <BookCard
            title={book.data.title}
            subtitle={book.data.subtitle}
            href={`/romans/${book.id}`}
            cover={book.data.cover}
            status={book.data.status}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
